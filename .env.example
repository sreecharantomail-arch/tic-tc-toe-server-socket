# Server Port (assigned automatically by cloud hosts)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=production

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example Local: mongodb://127.0.0.1:27017/nexaclash
# Example Atlas: mongodb+srv://username:password@cluster.mongodb.net/nexaclash
MONGO_URI=mongodb://127.0.0.1:27017/nexaclash

# JWT Secret for Player Authentication (Replace with secure random string)
JWT_SECRET=your_super_secret_production_jwt_key_here

# CORS Allowed Origin (* or https://your-domain.com)
CORS_ORIGIN=*

# Logging Level (error | warn | info | debug)
LOG_LEVEL=info
